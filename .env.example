SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_voice_platform
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

JWT_SECRET=replace_with_a_secure_random_jwt_secret
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

AUTH_PASSWORD_RESET_FRONTEND_URL=http://localhost:3000
AUTH_PASSWORD_RESET_TOKEN_EXPIRATION=900000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

CALL_SESSION_KEY_PREFIX=voice:call-session:
CALL_SESSION_TTL=30m


# ==============================
# STT - Speech to Text
# ==============================

STT_PROVIDER=sarvam
STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
STT_API_KEY=your_sarvam_api_key
STT_MODEL=saaras:v4
STT_MODE=transcribe
STT_SAMPLE_RATE=16000
STT_TIMEOUT=30s
STT_MAX_AUDIO_SIZE_BYTES=52428800
STT_SUPPORTED_LANGUAGES=en-IN,hi-IN,mr-IN,ta-IN,te-IN,bn-IN


# ==============================
# LLM - Large Language Model
# ==============================

LLM_PROVIDER=sarvam
LLM_ENDPOINT=https://api.sarvam.ai/v1/chat/completions
LLM_API_KEY=your_sarvam_api_key
LLM_API_KEY_HEADER=api-subscription-key
LLM_MODEL=sarvam-105b-conversations
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_TOKENS=2000
LLM_STREAM=false
LLM_REASONING_EFFORT=
LLM_TIMEOUT=30s
LLM_CONNECTION_TIMEOUT=10s
LLM_RESPONSE_TIMEOUT=30s
LLM_SUPPORTED_LANGUAGES=en-IN,hi-IN,mr-IN,ta-IN,te-IN,kn-IN,ml-IN,gu-IN,bn-IN,pa-IN


# ==============================
# TTS - Text to Speech
# ==============================

TTS_PROVIDER=sarvam
TTS_ENDPOINT=https://api.sarvam.ai
TTS_API_KEY=your_sarvam_api_key
TTS_API_KEY_HEADER=api-subscription-key

TTS_MODEL=bulbul:v3

TTS_DEFAULT_SPEAKER=shubh
TTS_DEFAULT_LANGUAGE=en-IN
TTS_DEFAULT_PACE=1.0
TTS_DEFAULT_SPEECH_SAMPLE_RATE=22050

TTS_MAX_TEXT_CHARACTERS=2500
TTS_MIN_PACE=0.5
TTS_MAX_PACE=2.0

TTS_MAX_AUDIO_SIZE_BYTES=10485760

TTS_TIMEOUT=30s
TTS_CONNECTION_TIMEOUT=10s
TTS_RESPONSE_TIMEOUT=30s

TTS_SUPPORTED_LANGUAGES=en-IN,hi-IN,mr-IN,ta-IN,te-IN,kn-IN,ml-IN,gu-IN,bn-IN,pa-IN

TTS_SUPPORTED_SPEAKERS_MALE=shubh,ratan,aditya
TTS_SUPPORTED_SPEAKERS_FEMALE=priya,ishita,ritu

TTS_AUDIO_STORAGE_PATH=./uploads/tts
TTS_AUDIO_BASE_URL=http://localhost:8080/tts-audio


# ==============================
# Conversation Storage
# ==============================

CONVERSATION_STORAGE_PATH=./storage/conversations


# ==============================
# Exotel Configuration
# ==============================

EXOTEL_BASE_URL=https://api.exotel.com

EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=your_exotel_caller_id
EXOTEL_APP_ID=your_exotel_app_id

EXOTEL_APP_URL=https://my.exotel.com/your_account/exoml/start_voice/your_app_id

EXOTEL_STATUS_CALLBACK_URL=https://your-public-domain/api/v1/telephony/webhooks/exotel/call-events